# Copy to .env and fill in. Never commit .env.
CFPB_API_URL=https://www.consumerfinance.gov/data-research/consumer-complaints/search/api/v1/
CFPB_BULK_URL=https://files.consumerfinance.gov/ccdb/complaints.csv.zip
LOOKBACK_DAYS=30

# Snowflake - objects/users created by snowflake/setup.sql
# Account identifier: Snowsight > profile menu > Connect a tool to Snowflake, e.g. ORGNAME-ACCOUNTNAME
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=CFPB_LOADER_SVC
SNOWFLAKE_ROLE=CFPB_LOADER
SNOWFLAKE_WAREHOUSE=CFPB_WH
SNOWFLAKE_DATABASE=CFPB
SNOWFLAKE_SCHEMA=RAW
# Key-pair auth (created by snowflake/make_keys.sh). Leave empty to use SNOWFLAKE_PASSWORD instead.
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/cfpb_loader_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_PASSWORD=
